RewriteEngine On
# Desactivar MultiViews para que mod_rewrite procese las URLs antes
# (sin esto, Apache sirve /servicio como /servicio.html bypass rewrites)
Options -MultiViews

# ── CLEAN URLS PARA SERVICIOS Y CATEGORÍAS ──
# /servicio/atencion-podologica-integral → /servicio.html?id=atencion-podologica-integral
# /categoria/podologia-clinica            → /categoria.html?cat=podologia-clinica
# Mantiene los archivos .html accesibles internamente sin cambiar JS

# Redirect: query string viejo → path nuevo (canonical)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/servicio\.html\?id=([a-z0-9-]+)\s [NC]
RewriteRule ^ /servicio/%1? [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/servicio\?id=([a-z0-9-]+)\s [NC]
RewriteRule ^ /servicio/%1? [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/categoria\.html\?cat=([a-z0-9-]+)\s [NC]
RewriteRule ^ /categoria/%1? [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/categoria\?cat=([a-z0-9-]+)\s [NC]
RewriteRule ^ /categoria/%1? [R=301,L]

# Internal rewrite: /servicio/{slug} → /servicio.html?id={slug}
RewriteRule ^servicio/([a-z0-9-]+)/?$ /servicio.html?id=$1 [L,QSA]
RewriteRule ^categoria/([a-z0-9-]+)/?$ /categoria.html?cat=$1 [L,QSA]

# ── PROMO: URL dinámica según el evento activo ──
# URL vieja (día de la madre) → página genérica
RewriteRule ^promocion-dia-de-la-madre(\.html)?/?$ /promocion [R=301,L]
# /promocion, /promocion/{slug} y cualquier variante (mayúsculas, tildes,
# guion en vez de slash) → promocion.html. El slug es cosmético; la página
# carga el evento activo y normaliza la URL visible.
RewriteRule ^promocion([-/].*)?$ /promocion.html [L,QSA,NC]

# Remove .html extension (general)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} \.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# ── PERFORMANCE: GZIP / BROTLI COMPRESSION ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/x-font-ttf font/opentype
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# ── PERFORMANCE: CACHE HEADERS ──
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — el navegador pregunta siempre si cambio (ver Cache-Control abajo)
  ExpiresByType text/html "access plus 0 seconds"
  # CSS / JS — mediano (usamos ?v=N para cache-bust)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  # Imágenes — largo
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # Fuentes
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Cache-Control para repeat visits
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    # El HTML se guardaba una hora en el navegador, y dentro del HTML va el
    # numero de version de los scripts: alguien podia quedarse hasta una hora
    # con la pagina vieja, pidiendo scripts viejos y viendo precios que ya no
    # eran. Ahora pregunta siempre; si nada cambio el servidor responde "igual
    # que antes" y no se descarga de nuevo, asi que no se pierde velocidad.
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Security: prevenir directory listing
Options -Indexes

# Security: bloquear archivos sensibles (SQL, config, ejemplos)
<FilesMatch "\.(sql|example\.php|md)$">
  Require all denied
</FilesMatch>

# Security: bloquear sesiones del bot (historial de conversaciones)
RedirectMatch 403 ^/api/bot-sessions/

# ── El enlace antiguo del panel lleva al nuevo ──
RewriteRule ^panel-infinity-x7q9k2(\.html)?/?$ /agenda [R=301,L]

# ── PANEL Y ADMINISTRACIÓN: nunca cachear ──
# El panel cambia seguido y no debe quedar servido desde la caché del CDN.
# (Las páginas públicas conservan su caché normal de 1 hora.)
<FilesMatch "^(agenda|admin)\.html$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>

# ── API: nunca cachear ──
# Las respuestas de la API llevan datos del negocio y dependen de quién pregunta:
# si el CDN las guarda, podría entregárselas a alguien sin sesión.
<FilesMatch "\.php$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
</FilesMatch>
